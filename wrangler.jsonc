// Cloudflare Worker configuration for the Littlefield dashboard.
// Workers Builds runs `npx wrangler deploy` with this file on every push to the production branch.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or the build is refused.
  "name": "littlefield",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The site: public/ is served as static files. Only /api/* runs the Worker code.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The only address is the custom domain, which Cloudflare Access protects.
  // workers.dev and preview URLs are off so nobody can reach the data around Access.
  "routes": [{ "pattern": "littlefield.jay.systems", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Snapshot store. With no "id", Wrangler creates the namespace on the first deploy
  // and reuses it afterwards. To use a namespace made by hand, add "id": "<namespace id>".
  "kv_namespaces": [{ "binding": "LF_KV" }],

  "observability": { "enabled": true },

  // "1" after the course: the live advisor, its log export and ingest are switched off and the
  // advisor drawer shows saved examples (public/advisor-examples.json). See docs/OPERATIONS.md.
  "vars": { "PORTFOLIO_MODE": "0" },

 // "vars": {
 //   "ENVIRONMENT": "production"
 // },
 // "r2_buckets": [
 //   {
 //     "binding": "UPLOADS",
 //     "bucket_name": "prod-uploads"
 //   }
 // ],
  // ...
  "previews": {
    // ...
   // "vars": {
   //   "ENVIRONMENT": "preview"
   // },
   // "r2_buckets": [
   //   {
   //     "binding": "UPLOADS",
   //     "bucket_name": "r2-staging"
   //   }
   // ]
    // ...
  }

  // Secrets (Worker > Settings > Variables and Secrets, type Secret; never in this repository):
  //   INGEST_SECRET       shared with the Google Sheet's script
  //   ANTHROPIC_API_KEY   the advisor's Claude API key (Phase 3)
  //   ACCESS_TEAM_DOMAIN, ACCESS_AUD  optional: verify Cloudflare Access tokens on the advisor
  // Add these as Secrets, not Text: a deploy removes Text variables that are not in this file.

}
